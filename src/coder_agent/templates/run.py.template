# ============================ FIXED: scaffold imports =========================
import json
import logging
import sys
import time
import traceback
from pathlib import Path

EXPERIMENT_ID = "__EXPERIMENT_ID__"
RESULTS_PATH = Path(__file__).parent / "results.json"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)-7s | %(message)s",
    stream=sys.stdout,
)
log = logging.getLogger(EXPERIMENT_ID)

# ========================== GENERATED: imports ===============================
__IMPORTS__

# ======================== GENERATED: configuration ===========================
__CONFIGURATION__

# =========================== GENERATED: helpers ==============================
__HELPERS__

# ========================== GENERATED: load_data =============================
__LOAD_DATA__

# ========================= GENERATED: preprocess =============================
__PREPROCESS__

# ======================== GENERATED: build_model =============================
__BUILD_MODEL__

# ======================= GENERATED: run_experiment ===========================
__RUN_EXPERIMENT__

# =========================== GENERATED: evaluate =============================
__EVALUATE__


# ====================== FIXED: orchestration footer ==========================
# Everything below is scaffold. It defines what "the experiment finished" means
# and is deliberately not model-written: a run that crashes must still leave a
# machine-readable account of how it crashed, and a run that succeeds must write
# its metrics in a shape the agent can check against the plan.


def _json_safe(value, _depth=0):
    """Best-effort conversion of numpy/pandas/arviz values into JSON types."""
    if _depth > 6:
        return str(value)
    if value is None or isinstance(value, (bool, int, float, str)):
        return value
    if isinstance(value, dict):
        return {str(k): _json_safe(v, _depth + 1) for k, v in value.items()}
    if isinstance(value, (list, tuple, set)):
        return [_json_safe(v, _depth + 1) for v in value]
    for attribute in ("tolist", "item", "to_dict"):
        if hasattr(value, attribute):
            try:
                return _json_safe(getattr(value, attribute)(), _depth + 1)
            except Exception:
                pass
    return str(value)


def _write(payload):
    payload["experiment_id"] = EXPERIMENT_ID
    RESULTS_PATH.write_text(json.dumps(_json_safe(payload), indent=2, default=str))
    log.info("wrote %s", RESULTS_PATH)


def main():
    started = time.time()
    try:
        log.info("loading data")
        raw = load_data()

        log.info("preprocessing")
        prepared = preprocess(raw)

        log.info("building model")
        model = build_model(prepared)

        log.info("running experiment")
        outputs = run_experiment(model, prepared)

        log.info("evaluating")
        evaluation = evaluate(outputs, prepared)

        if not isinstance(evaluation, dict):
            raise TypeError(
                f"evaluate() must return a dict of metrics, got {type(evaluation).__name__}"
            )

        # `evaluate` may return either the metrics directly or an envelope with a
        # metrics key. Accept both rather than fail a correct run on a shape detail.
        metrics = evaluation.get("metrics") if "metrics" in evaluation else evaluation
        payload = {
            "status": "completed",
            "metrics": metrics,
            "hypothesis_outcome": evaluation.get("hypothesis_outcome", "inconclusive"),
            "meets_success_criteria": bool(evaluation.get("meets_success_criteria", False)),
            "notes": evaluation.get("notes", ""),
            "duration_seconds": round(time.time() - started, 2),
            "error": None,
        }
        _write(payload)
        log.info("done in %.1fs", payload["duration_seconds"])
        return 0

    except Exception as exc:
        # Record the failure in the results file as well as on stderr. The agent's
        # classifier reads whichever it can get, and a job whose log was truncated
        # by the scheduler still leaves this behind.
        _write(
            {
                "status": "failed",
                "metrics": {},
                "hypothesis_outcome": "inconclusive",
                "meets_success_criteria": False,
                "duration_seconds": round(time.time() - started, 2),
                "error": {
                    "type": type(exc).__name__,
                    "message": str(exc),
                    "traceback": traceback.format_exc(),
                },
            }
        )
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
