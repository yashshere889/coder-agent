# The vLLM server started by scripts/serve_vllm.sh (same node, same job).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
# Completion cap. Must leave room under LLM_CONTEXT_WINDOW for the prompt.
LLM_MAX_TOKENS=16384
# MUST match the --max-model-len vLLM was actually started with.
LLM_CONTEXT_WINDOW=131072

# Where generated experiments live (one subdir per hypothesis id).
CODER_EXPERIMENTS_DIR=experiments
# Where the per-experiment overlay venvs live. Empty = beside the results.
# On Barkla set this to localscratch (/tmp/users/$USER/...): a venv is thousands
# of small files and fastscratch has a 500k inode quota.
CODER_VENV_ROOT=
# The pinned base environment built by scripts/build_base_env.sh.
CODER_BASE_ENV=
# GPUs the generated experiment may use. vLLM holds the rest.
CODER_EXPERIMENT_GPUS=1

# Budgets. Separate on purpose: they fail for unrelated reasons.
CODER_MAX_CODE_ATTEMPTS=4
CODER_MAX_ENV_REPAIRS=6
CODER_MAX_FORMAT_RETRIES=2

# Per-execution wall clock, by plan complexity.
CODER_TIMEOUT_LOW=300
CODER_TIMEOUT_MEDIUM=1800
CODER_TIMEOUT_HIGH=7200
# Address-space rlimit for generated code, in GB.
CODER_MEMORY_LIMIT_GB=32
